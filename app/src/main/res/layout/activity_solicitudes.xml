<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ZONA SUPERIOR BLANCA (Encabezado + Pestañas) -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Encabezado: MESA DE SERVICIO / Solicitudes + Botón Filtro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="MESA DE SERVICIO"
                    android:textColor="#188653"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Solicitudes"
                    android:textColor="#0F2537"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFiltroSolicitudes"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_card_outline"
                android:contentDescription="Filtrar solicitudes"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_filter"
                app:tint="#475569" />
        </LinearLayout>

        <!-- Barra de pestañas: Pendientes 12 | En atención 6 | Finalizadas -->
        <LinearLayout
            android:id="@+id/contenedorPestanas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <!-- Pestaña 1: Pendientes (Activa) -->
            <LinearLayout
                android:id="@+id/tabPendientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvTabPendientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pendientes"
                        android:textColor="#0F2537"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCountPendientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="12"
                        android:textColor="#188653"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/indicadorPendientes"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:background="#188653" />
            </LinearLayout>

            <!-- Pestaña 2: En atención -->
            <LinearLayout
                android:id="@+id/tabEnAtencion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvTabEnAtencion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En atención"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCountEnAtencion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="6"
                        android:textColor="#188653"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/indicadorEnAtencion"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- Pestaña 3: Finalizadas -->
            <LinearLayout
                android:id="@+id/tabFinalizadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTabFinalizadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:text="Finalizadas"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/indicadorFinalizadas"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Línea divisoria bajo pestañas -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />
    </LinearLayout>

    <!-- BARRA DE BÚSQUEDA -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_outline"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_buscar"
            app:tint="#94A3B8" />

        <EditText
            android:id="@+id/etBuscarSolicitud"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:hint="Buscar folio, usuario o área..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#0F2537"
            android:textColorHint="#94A3B8"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- LISTA DE TARJETAS DE SOLICITUDES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSolicitudesMesa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/divisorInferior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBarContainer"
        tools:itemCount="4"
        tools:listitem="@layout/item_solicitud_mesa" />

    <!-- DIVISOR SOBRE MENÚ INFERIOR -->
    <View
        android:id="@+id/divisorInferior"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        app:layout_constraintBottom_toTopOf="@id/navInferior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- BARRA DE NAVEGACIÓN INFERIOR (Panel | Inventario | Solicitudes activo | Perfil) -->
    <LinearLayout
        android:id="@+id/navInferior"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 1. Panel -->
        <LinearLayout
            android:id="@+id/navPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavPanel"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Panel"
                android:src="@drawable/ic_panel"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/lblNavPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Panel"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Inventario -->
        <LinearLayout
            android:id="@+id/navInventario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavInventario"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Inventario"
                android:src="@drawable/ic_inventario"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/lblNavInventario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inventario"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. Solicitudes (Activo) -->
        <LinearLayout
            android:id="@+id/navSolicitudes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavSolicitudes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Solicitudes"
                android:src="@drawable/ic_solicitudes"
                app:tint="#188653" />

            <TextView
                android:id="@+id/lblNavSolicitudes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Solicitudes"
                android:textColor="#188653"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. Perfil -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavPerfil"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Perfil"
                android:src="@drawable/ic_perfil"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/lblNavPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Perfil"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>