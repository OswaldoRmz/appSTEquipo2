<?xml version="1.0" encoding="utf-8"?>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".Vista.SolicitudesActivity">

    <!-- ENCABEZADO BLANCO SUPERIOR -->
    <LinearLayout
        android:id="@+id/headerSolicitudes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Fila: SEGUIMIENTO / Mis solicitudes + Botón lupa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="SEGUIMIENTO"
                    android:textColor="#188653"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mis solicitudes"
                    android:textColor="#0F172A"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Botón cuadrado de búsqueda -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnToggleBuscar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search"
                    app:tint="#475569" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Barra de búsqueda oculta que aparece al tocar la lupa -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBuscadorSolicitudes"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="#F8FAFC"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/etBuscarSolicitud"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Buscar por folio, equipo o servicio..."
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- PESTAÑAS: Activas | Resueltas | Todas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <!-- Tab 1: Activas -->
            <LinearLayout
                android:id="@+id/tabActivas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tvTabActivas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activas"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBadgeActivas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_help_banner"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textColor="#188653"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/indActivas"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#188653" />
            </LinearLayout>

            <!-- Tab 2: Resueltas -->
            <LinearLayout
                android:id="@+id/tabResueltas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTabResueltas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="Resueltas"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/indResueltas"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#188653"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Tab 3: Todas -->
            <LinearLayout
                android:id="@+id/tabTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTabTodas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="Todas"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/indTodas"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#188653"
                    android:visibility="invisible" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Línea divisoria bajo pestañas -->
    <View
        android:id="@+id/dividerTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSolicitudes" />

    <!-- ESPACIO PARA CARGAR LAS SOLICITUDES DESDE LA BASE DE DATOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSolicitudes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/dividerBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerTop" />

    <!-- Texto si no hay solicitudes en esa pestaña -->
    <TextView
        android:id="@+id/tvSinSolicitudes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No tienes solicitudes en esta sección"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/dividerBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerTop" />

    <!-- Línea divisoria superior del menú inferior -->
    <View
        android:id="@+id/dividerBottom"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Menú de navegación inferior: Inicio > Servicios > Solicitudes (Activo) > Soporte -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 1. Inicio -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavInicio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Inicio"
                android:src="@drawable/ic_inicio"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/lblNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inicio"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Servicios -->
        <LinearLayout
            android:id="@+id/navServicios"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavServicios"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Servicios"
                android:src="@drawable/ic_servicios"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/lblNavServicios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Servicios"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. Solicitudes (Activo) -->
        <LinearLayout
            android:id="@+id/navSolicitudes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavSolicitudes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Solicitudes"
                android:src="@drawable/ic_solicitudes"
                app:tint="#188653" />

            <TextView
                android:id="@+id/lblNavSolicitudes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Solicitudes"
                android:textColor="#188653"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. Soporte -->
        <LinearLayout
            android:id="@+id/navSoporte"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavSoporte"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Soporte"
                android:src="@drawable/ic_soporte"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/lblNavSoporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Soporte"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>