<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:gravity="center_horizontal"
    android:minWidth="72dp"
    android:orientation="vertical">

    <!-- Cuadro con el ícono (cambia de color cuando está seleccionada) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCategoria"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivIconoCategoria"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Categoría"
            android:src="@drawable/ic_desktop_windows"
            app:tint="#475569" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Nombre de la categoría -->
    <TextView
        android:id="@+id/tvNombreCategoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="Cómputo"
        android:textColor="#64748B"
        android:textSize="12sp" />
</LinearLayout>