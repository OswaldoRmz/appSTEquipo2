<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lytTarjetaPregunta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:background="@drawable/borde_tarjeta_10"
    android:orientation="vertical"
    android:paddingEnd="12dp"
    android:paddingStart="12dp">

    <LinearLayout
        android:id="@+id/lytEncabezadoPregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="49dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtPregunta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:lineSpacingMultiplier="1.1"
            android:textColor="#344B5E"
            android:textSize="12.5sp"
            tools:text="¿Cómo solicito el préstamo de un equipo?"/>

        <ImageView
            android:id="@+id/imgFlechaPregunta"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron"
            android:tint="#8996A0"/>
    </LinearLayout>

    <View
        android:id="@+id/vwDivisorRespuesta"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginEnd="24dp"
        android:background="#EDF1F3"
        android:visibility="gone"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/txtRespuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/inter_regular"
        android:lineSpacingMultiplier="1.28"
        android:paddingTop="9dp"
        android:textColor="#6F7F8B"
        android:textSize="11.5sp"
        android:visibility="gone"
        tools:text="Elige un equipo disponible, indica la fecha y horario del préstamo y envía la solicitud para revisión."
        tools:visibility="visible"/>
</LinearLayout>