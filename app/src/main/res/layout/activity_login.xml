<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B2947"
    android:orientation="vertical"
    tools:context=".Vista.LoginActivity">

    <FrameLayout
        android:id="@+id/lytContenedorLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/vwOrbitaSuperiorLogin"
            android:layout_width="290dp"
            android:layout_height="290dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-119dp"
            android:layout_marginEnd="-140dp"
            android:background="@drawable/orbita_acceso"/>

        <View
            android:id="@+id/vwOrbitaLateralLogin"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="106dp"
            android:layout_marginStart="-110dp"
            android:background="@drawable/orbita_acceso"/>

        <LinearLayout
            android:id="@+id/lytMarcaLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgLogoLogin"
                android:layout_width="53dp"
                android:layout_height="53dp"
                android:contentDescription="Capsule Tech"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_capsule_blanco"/>

            <LinearLayout
                android:id="@+id/lytTextosMarcaLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNombreMarcaLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="Capsule Tech"
                    android:textColor="#FFFFFF"
                    android:textSize="16.5sp"/>

                <TextView
                    android:id="@+id/txtDescriptorMarcaLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_regular"
                    android:letterSpacing="0.04"
                    android:text="Servicios tecnológicos"
                    android:textAllCaps="true"
                    android:textColor="#A9BED0"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/scvTarjetaLogin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="111dp"
            android:background="@drawable/fondo_hoja_superior_28"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lytTarjetaLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="39dp"
                android:paddingEnd="27dp"
                android:paddingStart="27dp"
                android:paddingTop="39dp">

                <TextView
                    android:id="@+id/txtEtiquetaPortal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="0.083"
                    android:text="PORTAL DE SERVICIOS TECNOLOGICOS"
                    android:textColor="#27885B"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtTituloLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="@font/inter_regular"
                    android:letterSpacing="-0.033"
                    android:text="Bienvenido!"
                    android:textColor="#112A43"
                    android:textSize="27sp"/>

                <TextView
                    android:id="@+id/txtDescripcionLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="25dp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingMultiplier="1.24"
                    android:text="Ingresa con tus credenciales para continuar."
                    android:textColor="#7D8995"
                    android:textSize="14.5sp"/>

                <TextView
                    android:id="@+id/txtEtiquetaMatriculaLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="Matrícula o clave"
                    android:textColor="#34495C"
                    android:textSize="13.5sp"/>

                <LinearLayout
                    android:id="@+id/lytCampoMatriculaLogin"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginTop="7dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/borde_campo_acceso"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="12dp"
                    android:paddingStart="12dp">

                    <ImageView
                        android:id="@+id/imgIconoMatriculaLogin"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_persona"
                        android:tint="#82919D"/>

                    <EditText
                        android:id="@+id/edtMatriculaLogin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/inter_bold"
                        android:hint="Ej. 2024-01842"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="#263A4D"
                        android:textColorHint="#A0AAB2"
                        android:textSize="14.5sp"
                        tools:text="2024-01842"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEtiquetaContrasenaLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="Contraseña"
                    android:textColor="#34495C"
                    android:textSize="13.5sp"/>

                <LinearLayout
                    android:id="@+id/lytCampoContrasenaLogin"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginTop="7dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/borde_campo_acceso"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="12dp"
                    android:paddingStart="12dp">

                    <ImageView
                        android:id="@+id/imgIconoContrasenaLogin"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_candado"
                        android:tint="#82919D"/>

                    <EditText
                        android:id="@+id/edtContrasenaLogin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/inter_bold"
                        android:hint="Ingresa tu contraseña"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="#263A4D"
                        android:textColorHint="#A0AAB2"
                        android:textSize="14.5sp"
                        tools:text="institucional"/>

                    <ImageButton
                        android:id="@+id/btnMostrarContrasenaLogin"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Mostrar contraseña"
                        android:padding="5.5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ojo"
                        android:tint="#84919D"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnOlvidasteContrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:paddingBottom="4dp"
                    android:paddingTop="4dp"
                    android:text="¿Olvidaste tu contraseña?"
                    android:textColor="#267D54"
                    android:textSize="12.5sp"/>

                <Button
                    android:id="@+id/btnIniciarSesionLogin"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/inter_bold"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:letterSpacing="0"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="Iniciar sesión"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    app:backgroundTint="#0C3155"
                    app:cornerRadius="10dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_flecha"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp"
                    app:iconSize="17dp"
                    app:iconTint="#FFFFFF"/>

                <LinearLayout
                    android:id="@+id/lytNotaSeguridadLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgEscudoLogin"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_escudo"
                        android:tint="#94A0AA"/>

                    <TextView
                        android:id="@+id/txtNotaSeguridadLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="Acceso protegido por la institución"
                        android:textColor="#94A0AA"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>