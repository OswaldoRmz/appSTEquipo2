<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FA"
    android:orientation="vertical"
    tools:context=".Vista.PreguntasFrecuentesActivity">

    <LinearLayout
        android:id="@+id/lytBarraSuperiorAyuda"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="12dp"
        android:paddingStart="12dp">

        <ImageButton
            android:id="@+id/btnRegresarAyuda"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Regresar"
            android:padding="6.5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_atras"
            android:tint="#405365"/>

        <TextView
            android:id="@+id/txtTituloAyuda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:maxLines="1"
            android:text="Preguntas frecuentes"
            android:textColor="#142D45"
            android:textSize="15.5sp"/>

        <ImageButton
            android:id="@+id/btnContactarSoporteBarra"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Contactar soporte"
            android:padding="7.5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_audifonos"
            android:tint="#405365"/>
    </LinearLayout>

    <View
        android:id="@+id/vwDivisorBarraSuperiorAyuda"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8ECEF"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scvPreguntasFrecuentes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/lytContenidoPreguntas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/lytIntroAyuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/fondo_intro_ayuda"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgIconoAyuda"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/fondo_redondeado_11"
                    android:contentDescription="@null"
                    android:elevation="2dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_soporte"
                    android:tint="#237C55"/>

                <LinearLayout
                    android:id="@+id/lytTextosIntroAyuda"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtEtiquetaCentroAyuda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_extrabold"
                        android:letterSpacing="0.073"
                        android:text="CENTRO DE AYUDA"
                        android:textColor="#2C8B61"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtTituloIntroAyuda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="¿En qué podemos ayudarte?"
                        android:textColor="#173B2E"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txtDescripcionIntroAyuda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.16"
                        android:text="Encuentra respuestas rápidas a las dudas más comunes."
                        android:textColor="#678076"
                        android:textSize="11.5sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lytBusquedaPregunta"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/borde_busqueda"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="12dp"
                android:paddingStart="12dp">

                <ImageView
                    android:id="@+id/imgIconoBusquedaPregunta"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_buscar"
                    android:tint="#8996A0"/>

                <EditText
                    android:id="@+id/edtBuscarPregunta"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Buscar una pregunta..."
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#34495B"
                    android:textColorHint="#97A2AB"
                    android:textSize="12.5sp"/>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/hsvCategoriasPreguntas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="3dp"
                android:paddingEnd="16dp"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/rdgCategoriasPreguntas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/rdbCategoriaTodas"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rdbCategoriaTodas"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/selector_chip_filtro"
                        android:button="@null"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:paddingEnd="10dp"
                        android:paddingStart="10dp"
                        android:text="Todas"
                        android:textColor="@color/texto_chip_filtro"
                        android:textSize="11.5sp"/>

                    <RadioButton
                        android:id="@+id/rdbCategoriaPrestamos"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/selector_chip_filtro"
                        android:button="@null"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:paddingEnd="10dp"
                        android:paddingStart="10dp"
                        android:text="Préstamos"
                        android:textColor="@color/texto_chip_filtro"
                        android:textSize="11.5sp"/>

                    <RadioButton
                        android:id="@+id/rdbCategoriaMantenimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/selector_chip_filtro"
                        android:button="@null"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:paddingEnd="10dp"
                        android:paddingStart="10dp"
                        android:text="Mantenimiento"
                        android:textColor="@color/texto_chip_filtro"
                        android:textSize="11.5sp"/>
                </RadioGroup>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/lytEncabezadoPreguntas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingBottom="9dp"
                android:paddingEnd="17dp"
                android:paddingStart="17dp"
                android:paddingTop="17dp">

                <LinearLayout
                    android:id="@+id/lytTitulosPreguntas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtEtiquetaRespuestasRapidas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_extrabold"
                        android:letterSpacing="0.059"
                        android:text="RESPUESTAS RÁPIDAS"
                        android:textColor="#2B8A5E"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtTituloLoMasConsultado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="Lo más consultado"
                        android:textColor="#17334B"
                        android:textSize="16sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtContadorPreguntas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="6 preguntas"
                    android:textColor="#8C98A2"
                    android:textSize="11sp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPreguntasFrecuentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingEnd="16dp"
                android:paddingStart="16dp"
                tools:itemCount="6"
                tools:listitem="@layout/item_pregunta"/>

            <LinearLayout
                android:id="@+id/lytContactoSoporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/borde_tarjeta_11"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="11dp">

                <ImageView
                    android:id="@+id/imgIconoContactoSoporte"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/fondo_redondeado_8"
                    android:backgroundTint="#E8F5EE"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_audifonos"
                    android:tint="#2A8059"/>

                <LinearLayout
                    android:id="@+id/lytTextosContactoSoporte"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloContactoSoporte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="¿No encontraste tu respuesta?"
                        android:textColor="#34495B"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/txtDescripcionContactoSoporte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="Nuestro equipo puede ayudarte."
                        android:textColor="#8B97A0"
                        android:textSize="11sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnContactarSoporte"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:layout_marginStart="9dp"
                    android:fontFamily="@font/inter_bold"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:letterSpacing="0"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingEnd="9dp"
                    android:paddingStart="9dp"
                    android:text="Contactar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:backgroundTint="#0C3155"
                    app:cornerRadius="8dp"
                    app:elevation="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/vwDivisorNavegacion"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E9ED"/>

    <LinearLayout
        android:id="@+id/lytNavegacionInferior"
        android:layout_width="match_parent"
        android:layout_height="61dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/lytNavInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavInicio"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_casa"
                android:tint="#8B98A3"/>

            <TextView
                android:id="@+id/txtNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_regular"
                android:text="Inicio"
                android:textColor="#8B98A3"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lytNavSolicitudes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavSolicitudes"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_solicitudes"
                android:tint="#8B98A3"/>

            <TextView
                android:id="@+id/txtNavSolicitudes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_regular"
                android:text="Solicitudes"
                android:textColor="#8B98A3"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lytNavSoporte"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavSoporte"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_soporte"
                android:tint="#0B7950"/>

            <TextView
                android:id="@+id/txtNavSoporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_bold"
                android:text="Soporte"
                android:textColor="#0B7950"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lytNavPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavPerfil"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_usuario"
                android:tint="#8B98A3"/>

            <TextView
                android:id="@+id/txtNavPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_regular"
                android:text="Perfil"
                android:textColor="#8B98A3"
                android:textSize="11.5sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>