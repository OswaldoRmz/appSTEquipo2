<?xml version="1.0" encoding="utf-8"?>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <!-- BARRA SUPERIOR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnRegresarFaq"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Regresar"
            android:src="@drawable/ic_arrow_back"
            app:tint="#16263E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Preguntas frecuentes"
            android:textColor="#16263E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSoporteDirecto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Contactar soporte"
            android:src="@drawable/ic_headset"
            app:tint="#4A5568" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAEFF4" />

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp">

        <!-- Banner Centro de Ayuda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_help_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_white_icon_14">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Centro de ayuda"
                    android:src="@drawable/ic_headset"
                    app:tint="#238656" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="CENTRO DE AYUDA"
                    android:textColor="#238656"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="¿En qué podemos ayudarte?"
                    android:textColor="#16263E"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Encuentra respuestas rápidas a las dudas más comunes."
                    android:textColor="#52606D"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Barra de búsqueda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_outline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Buscar"
                android:src="@drawable/ic_search"
                app:tint="#9AA5B1" />

            <EditText
                android:id="@+id/etBuscarPregunta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="Buscar una pregunta..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#16263E"
                android:textColorHint="#9AA5B1"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Encabezado de sección -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="RESPUESTAS RÁPIDAS"
                    android:textColor="#238656"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lo más consultado"
                    android:textColor="#16263E"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvContadorPreguntas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 preguntas"
                android:textColor="#7B8794"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Lista de tarjetas desplegables -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPreguntasFrecuentes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            tools:itemCount="4"
            tools:listitem="@layout/item_pregunta" />

    </LinearLayout>

    <!-- Divisor sobre menú inferior -->
    <View
        android:id="@+id/divisorInferior"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Menú de navegación inferior: Inicio > Servicios > Solicitudes > Soporte -->
    <LinearLayout
        android:id="@+id/navInferior"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="4">

        <!-- 1. Inicio -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavInicio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Inicio"
                android:src="@drawable/ic_inicio"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/lblNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inicio"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Servicios -->
        <LinearLayout
            android:id="@+id/navServicios"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavServicios"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Servicios"
                android:src="@drawable/ic_servicios"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/lblNavServicios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Servicios"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. Solicitudes -->
        <LinearLayout
            android:id="@+id/navSolicitudes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavSolicitudes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Solicitudes"
                android:src="@drawable/ic_solicitudes"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/lblNavSolicitudes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Solicitudes"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4. Soporte (Activo) -->
        <LinearLayout
            android:id="@+id/navSoporte"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavSoporte"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Soporte"
                android:src="@drawable/ic_soporte"
                app:tint="#188653" />

            <TextView
                android:id="@+id/lblNavSoporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Soporte"
                android:textColor="#188653"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>