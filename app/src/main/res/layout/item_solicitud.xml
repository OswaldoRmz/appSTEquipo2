<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_outline"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Fila superior  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPrioridadBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_urgente"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="URGENTE"
            android:textColor="#DC2626"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFolioSolicitud"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="#ST-2024-0842"
            android:textColor="#7B8794"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#9AA5B1" />
    </LinearLayout>

    <!-- Título del reporte -->
    <TextView
        android:id="@+id/tvTituloSolicitud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Sin conexión a internet"
        android:textColor="#16263E"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Lugar y tiempo -->
    <TextView
        android:id="@+id/tvUbicacionTiempo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Lab. Cómputo 2 · Hace 8 min"
        android:textColor="#7B8794"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#F0F2F5" />

    <!-- Pie de tarjeta: Asignado + Estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_person"
            app:tint="#7B8794" />

        <TextView
            android:id="@+id/tvTecnicoAsignado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Sin asignar"
            android:textColor="#7B8794"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvEstadoTicket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo"
            android:textColor="#238656"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
