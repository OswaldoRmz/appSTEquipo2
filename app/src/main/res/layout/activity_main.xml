<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B2947" android:orientation="vertical" tools:context=".Vista.MainActivity">

    <FrameLayout
        android:id="@+id/lytContenedorBienvenida"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/vwResplandorBienvenida"
            android:layout_width="330dp"
            android:layout_height="330dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-165dp"
            android:layout_marginEnd="-160dp"
            android:background="@drawable/resplandor_bienvenida"/>

        <LinearLayout
            android:id="@+id/lytContenidoBienvenida"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/lytMarcaBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="23dp"
                android:paddingStart="23dp"
                android:paddingTop="14dp">

                <ImageView
                    android:id="@+id/imgLogoBienvenida"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:contentDescription="Capsule Tech"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_capsule_blanco"/>

                <LinearLayout
                    android:id="@+id/lytTextosMarcaBienvenida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNombreMarcaBienvenida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:letterSpacing="0.006"
                        android:text="Capsule Tech"
                        android:textColor="#FFFFFF"
                        android:textSize="16.5sp"/>

                    <TextView
                        android:id="@+id/txtDescriptorMarcaBienvenida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_regular"
                        android:letterSpacing="0.052"
                        android:text="Servicios tecnológicos"
                        android:textAllCaps="true"
                        android:textColor="#A9BED0"
                        android:textSize="11.5sp"/>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/lytIlustracionBienvenida"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:minHeight="220dp">

                <FrameLayout
                    android:id="@+id/lytInsigniaCableBienvenida"
                    android:layout_width="49dp"
                    android:layout_height="49dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="38dp"
                    android:layout_marginBottom="48dp"
                    android:rotation="-8">
                </FrameLayout>

                <ImageView
                    android:id="@+id/imgEquipoTecnicoBienvenida"
                    android:layout_width="408dp"
                    android:layout_height="318dp"
                    android:layout_gravity="center"
                    android:contentDescription="Monitor, teclado, mouse, cables y herramientas técnicas"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_equipo_tecnico" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/lytHojaBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_hoja_superior_29"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingTop="32dp"
                android:paddingEnd="26dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/txtLemaBienvenida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="0.096"
                    android:text="TU TECNOLOGÍA, SIEMPRE LISTA"
                    android:textColor="#288B5C"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtTituloBienvenida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="@font/inter_regular"
                    android:letterSpacing="-0.042"
                    android:lineSpacingMultiplier="0.93"
                    android:maxWidth="290dp"
                    android:text="Todo lo que necesitas, en un solo lugar."
                    android:textColor="#102C49"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/txtDescripcionBienvenida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingMultiplier="1.36"
                    android:maxWidth="292dp"
                    android:text="Solicita equipos, recibe soporte y da seguimiento a tus servicios de forma simple."
                    android:textColor="#71808D"
                    android:textSize="14.5sp" />

                <Button
                    android:id="@+id/btnIniciarSesionBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginTop="23dp"
                    android:fontFamily="@font/inter_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Iniciar sesión"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    app:backgroundTint="#0C3155"
                    app:cornerRadius="10dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_flecha"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp"
                    app:iconSize="17dp"
                    app:iconTint="#FFFFFF" />

                <Button
                    android:id="@+id/btnCrearCuentaBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Crear una cuenta nueva"
                    android:textAllCaps="false"
                    android:textColor="#21415E"
                    android:textSize="14.5sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="10dp"
                    app:elevation="0dp"
                    app:strokeColor="#D4DDE3"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:id="@+id/lytConfianzaBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgEscudoBienvenida"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_escudo"
                        android:tint="#8A98A3" />

                    <TextView
                        android:id="@+id/txtConfianzaBienvenida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="Portal seguro para la comunidad institucional"
                        android:textColor="#8A98A3"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnAyudaBienvenida"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/fondo_circulo"
            android:backgroundTint="#0C3155"
            android:clickable="true"
            android:contentDescription="Abrir ayuda"
            android:elevation="8dp"
            android:focusable="true"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="\?"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>
    </FrameLayout>
</LinearLayout>