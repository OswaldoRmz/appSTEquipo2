<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E243D"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/fondo_bienvenida">

        <!-- Destello suave superior derecho -->
        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-60dp"
            android:background="@drawable/resplandor_bienvenida" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="36dp">

            <!-- Barra superior: Logo + SERVICIOS TECNOLÓGICOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLogoInstitucional"
                    android:layout_width="68dp"
                    android:layout_height="42dp"
                    android:contentDescription="Logo institucional"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_capsule_blanco" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:letterSpacing="0.08"
                    android:text="SERVICIOS TECNOLÓGICOS"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivIlustracionHero"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:contentDescription="Ilustración de servicios tecnológicos"
                android:scaleType="fitCenter"
                android:src="@drawable/img_equipo_tecnico"/>
        </LinearLayout>
    </FrameLayout>

    <!-- TARJETA BLANCA INFERIOR SUPERPUESTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-28dp"
        android:background="@drawable/bg_bottom_sheet_white"
        android:orientation="vertical"
        android:paddingHorizontal="26dp"
        android:paddingTop="32dp"
        android:paddingBottom="18dp">

        <!-- Etiqueta verde superior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="TU TECNOLOGÍA, SIEMPRE LISTA"
            android:textColor="#238656"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="Todo lo que necesitas,\nen un solo lugar."
            android:textColor="#16263E"
            android:textSize="27sp"
            android:textStyle="bold" />

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="Solicita equipos, recibe soporte y da seguimiento a tus servicios de forma simple."
            android:textColor="#627D98"
            android:textSize="14sp" />

        <!-- Botón principal: Iniciar sesión -->
        <LinearLayout
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_navy"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Botón secundario: Crear una cuenta nueva -->
        <TextView
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Crear una cuenta nueva"
            android:textColor="#16263E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Pie con escudo y mensaje de seguridad -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_verified_user"
                app:tint="#7B8794" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Portal seguro para la comunidad institucional"
                android:textColor="#7B8794"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Botón flotante de ayuda (?) en la esquina inferior derecha -->
        <FrameLayout
            android:id="@+id/btnAyuda"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_circle_navy"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>