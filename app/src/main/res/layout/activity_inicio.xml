<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBFCFD"
    android:orientation="vertical"
    tools:context=".Vista.InicioActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scvInicio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/lytContenidoInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/lytEncabezadoInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp"
                android:paddingEnd="17dp"
                android:paddingStart="17dp"
                android:paddingTop="13dp">

                <TextView
                    android:id="@+id/txtSaludoUsuario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:letterSpacing="-0.025"
                    android:text="Hola, Nombre"
                    android:textColor="#0B2947"
                    android:textSize="20sp"/>

                <FrameLayout
                    android:id="@+id/lytAvatarUsuario"
                    android:layout_width="37dp"
                    android:layout_height="37dp"
                    android:clickable="true"
                    android:contentDescription="Perfil"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtInicialAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/fondo_circulo"
                        android:backgroundTint="#DFF1E8"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="N"
                        android:textColor="#174D38"
                        android:textSize="13.5sp"/>

                    <View
                        android:id="@+id/vwIndicadorEnLinea"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginBottom="1dp"
                        android:background="@drawable/punto_en_linea"/>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lytBusquedaEquipo"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="17dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/borde_busqueda"
                android:elevation="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="11dp"
                android:paddingStart="11dp">

                <ImageView
                    android:id="@+id/imgIconoBusquedaEquipo"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_buscar"
                    android:tint="#8795A0"/>

                <EditText
                    android:id="@+id/edtBuscarEquipo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Buscar equipo o consumible..."
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#2D4153"
                    android:textColorHint="#97A2AB"
                    android:textSize="13.5sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lytEncabezadoCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:layout_marginTop="21dp"
                android:layout_marginEnd="17dp"
                android:layout_marginBottom="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtTituloCategorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="Categorías"
                    android:textColor="#142C43"
                    android:textSize="14.5sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lytCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingEnd="17dp"
                android:paddingStart="17dp">

                <LinearLayout
                    android:id="@+id/lytCategoriaTodos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgCategoriaTodos"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/fondo_redondeado_10"
                        android:backgroundTint="#0C3155"
                        android:contentDescription="@null"
                        android:elevation="3dp"
                        android:paddingBottom="13dp"
                        android:paddingTop="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_laptop"
                        android:tint="#FFFFFF"/>

                    <TextView
                        android:id="@+id/txtCategoriaTodos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="Todos"
                        android:textColor="#1D7E51"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lytCategoriaEquipos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgCategoriaEquipos"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/borde_categoria"
                        android:contentDescription="@null"
                        android:paddingBottom="13dp"
                        android:paddingTop="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_monitor"
                        android:tint="#536C7F"/>

                    <TextView
                        android:id="@+id/txtCategoriaEquipos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:text="Equipos"
                        android:textColor="#697784"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lytCategoriaConsumibles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgCategoriaConsumibles"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/borde_categoria"
                        android:contentDescription="@null"
                        android:paddingBottom="13dp"
                        android:paddingTop="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_consumibles"
                        android:tint="#536C7F"/>

                    <TextView
                        android:id="@+id/txtCategoriaConsumibles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:text="Consumibles"
                        android:textColor="#697784"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lytCategoriaCables"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgCategoriaCables"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/borde_categoria"
                        android:contentDescription="@null"
                        android:paddingBottom="13dp"
                        android:paddingTop="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_cable"
                        android:tint="#536C7F"/>

                    <TextView
                        android:id="@+id/txtCategoriaCables"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:text="Cables"
                        android:textColor="#697784"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lytEncabezadoDisponibles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="17dp"
                android:layout_marginBottom="11dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/lytTitulosDisponibles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloDisponibles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Disponibles ahora"
                        android:textColor="#142C43"
                        android:textSize="14.5sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnVerTotalEquipos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:padding="4dp"
                    android:text="12 equipos"
                    android:textColor="#788691"
                    android:textSize="12.5sp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEquiposDisponibles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingEnd="17dp"
                android:paddingStart="17dp"
                tools:itemCount="3"
                tools:listitem="@layout/item_equipo_disponible"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/vwDivisorNavegacion"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E9ED"/>

    <LinearLayout
        android:id="@+id/lytNavegacionInferior"
        android:layout_width="match_parent"
        android:layout_height="61dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/lytNavInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavInicio"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_casa"
                android:tint="#0B7950"/>

            <TextView
                android:id="@+id/txtNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_bold"
                android:text="Inicio"
                android:textColor="#0B7950"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lytNavSolicitudes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavSolicitudes"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_solicitudes"
                android:tint="#8B98A3"/>

            <TextView
                android:id="@+id/txtNavSolicitudes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_regular"
                android:text="Solicitudes"
                android:textColor="#8B98A3"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lytNavSoporte"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            :background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavSoporte"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_soporte"
                android:tint="#8B98A3"/>

            <TextView
                android:id="@+id/txtNavSoporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_regular"
                android:text="Soporte"
                android:textColor="#8B98A3"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lytNavPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavPerfil"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_usuario"
                android:tint="#8B98A3"/>

            <TextView
                android:id="@+id/txtNavPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_regular"
                android:text="Perfil"
                android:textColor="#8B98A3"
                android:textSize="11.5sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>